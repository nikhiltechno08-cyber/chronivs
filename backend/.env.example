DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/chronivs
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary (required for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_ROOT=chronivs

# Razorpay (server secrets — never expose KEY_SECRET to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Payment provider: mock (local/dev) | razorpay (real)
# mock is FORBIDDEN when APP_ENV=production
APP_ENV=development
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_RESULT=success

# Public frontend origin for published share links (no trailing slash)
PUBLIC_APP_URL=http://localhost:3000

# Browser origins allowed to call the API (CORS). Comma-separated.
# Use both localhost and 127.0.0.1 in local dev.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Resend email delivery (never expose API key to the frontend)
RESEND_API_KEY=
EMAIL_FROM=Chronivs <onboarding@resend.dev>
EMAIL_REPLY_TO=support@chronivs.com
