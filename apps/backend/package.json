{
  "name": "@chronivs/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Chronivs V2 backend — FastAPI application",
  "scripts": {
    "dev": "node ../../scripts/run-backend-python.mjs -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "node ../../scripts/run-backend-python.mjs -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "node ../../scripts/run-backend-python.mjs -m pytest",
    "lint": "node ../../scripts/run-backend-python.mjs -m ruff check .",
    "format": "node ../../scripts/run-backend-python.mjs -m ruff format .",
    "typecheck": "node ../../scripts/run-backend-python.mjs -m compileall -q app"
  }
}
