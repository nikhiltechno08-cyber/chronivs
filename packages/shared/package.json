{
  "name": "@chronivs/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, schemas, and utilities for Chronivs V2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./schemas": "./src/schemas/index.ts",
