    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@chronivs/config": "*",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3"
  }
}
