{
  "name": "chronivs-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Chronivs V2 — AI-powered Digital Experience Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@chronivs/frontend",
    "dev:frontend": "npm run dev --workspace=@chronivs/frontend",
    "dev:backend": "npm run dev --workspace=@chronivs/backend",
    "start:backend": "npm run start --workspace=@chronivs/backend",
    "test:backend": "npm run test --workspace=@chronivs/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@chronivs/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
